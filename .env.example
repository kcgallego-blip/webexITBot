# Webex Bot Configuration
WEBEX_BOT_ID=your_bot_id_here
WEBEX_ACCESS_TOKEN=your_access_token_here

# Service App OAuth (optional - for user-level access)
WEBEX_CLIENT_ID=your_client_id_here
WEBEX_CLIENT_SECRET=your_client_secret_here
WEBEX_REDIRECT_URI=http://localhost:3000/oauth/callback

# Server Configuration
PORT=3000
NODE_ENV=development

# Webhook Configuration (set to your public URL when deployed)
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET=your_webhook_secret_here

# Webex API Base URL (for testing with ngrok)
WEBEX_API_URL=https://webexapis.com/v1

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_TICKETS_TABLE=tickets
SUPABASE_AGENTS_TABLE=agents
