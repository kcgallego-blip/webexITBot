{
  "manifest_version": 3,
  "name": "Zendesk Ticket Helper",
  "version": "1.0.0",
  "description": "Detect Zendesk ticket number and save status to Supabase",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://*.zendesk.com/*", "https://*.supabase.co/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zendesk Ticket Helper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["*://*.zendesk.com/*"],
    "js": ["content.js"],
    "all_frames": true
  }],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
